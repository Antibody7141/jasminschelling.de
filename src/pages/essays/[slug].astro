---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { monthYear, pad, WORDMARK } from "../../utils";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((e) => ({ params: { slug: e.id }, props: { e } }));
}

const { e } = Astro.props;
const { Content } = await render(e);

const all = (await getCollection("essays")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const others = all.filter((x) => x.id !== e.id).slice(0, 2);
---

<Base title={`${e.data.title} — ${WORDMARK}`} description={e.data.excerpt}>
  <article class="max-w-[720px] mx-auto px-6 sm:px-8 py-16">
    <a
      href="/#essays"
      class="label underline decoration-1 underline-offset-4 hover:opacity-70 transition-opacity"
      style="color: #6d2417"
      >Zurück zu allen Essays</a
    >

    <header class="mt-12 mb-12 pb-10 border-b" style="border-color: rgba(109, 36, 23, 0.25);">
      {e.data.bild && (
        <>
          <img src={e.data.bild} alt="" class="w-full aspect-video object-cover mb-3" />
          {e.data.bildKi && (
            <p class="text-[10px] uppercase tracking-[0.2em] mb-8" style="color: #78716c;">
              KI-generiertes Bild
            </p>
          )}
        </>
      )}
      <p class="label mb-5" style="color: #7a392c;">
        Essay {pad(e.data.number)} · {monthYear(e.data.date)} · {e.data.minutes} Min. Lesezeit
      </p>
      <h1 class="font-serif text-3xl sm:text-5xl leading-[1.1] tracking-tight lowercase" style="color: #6d2417;">
        {e.data.title}
      </h1>
    </header>

    <div class="prose-essay">
      <Content />
    </div>

    {others.length > 0 && (
      <footer class="mt-16 pt-8 border-t" style="border-color: rgba(109, 36, 23, 0.25);">
        <p class="label mb-5" style="color: #6d2417;">Weiterlesen</p>
        <div class="divide-y divide-linen-200 border-y border-linen-200">
          {others.map((o) => (
            <a
              href={`/essays/${o.id}/`}
              class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 py-5"
            >
              <span
                class="font-serif text-xl lowercase group-hover:opacity-70 transition-opacity"
                style="color: #6d2417;"
                >{o.data.title}</span
              >
              <span class="text-xs uppercase tracking-wider shrink-0" style="color: #7e442e;">
                {monthYear(o.data.date)} · {o.data.minutes} Min.
              </span>
            </a>
          ))}
        </div>
      </footer>
    )}
  </article>
</Base>