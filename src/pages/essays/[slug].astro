---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { monthYear, pad, WORDMARK } from "../../utils";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((e) => ({ params: { slug: e.id }, props: { e } }));
}

const { e } = Astro.props;
const { Content } = await render(e);
---

<Base title={`${e.data.title} — ${WORDMARK}`} description={e.data.excerpt}>
  <article class="max-w-[720px] mx-auto px-6 sm:px-8 py-16">
    <a
      href="/#archiv"
      class="label underline decoration-1 underline-offset-4 hover:opacity-70 transition-opacity"
      style="color: #6d2417"
      >Zurück zu allen Essays</a
    >

    <header class="mt-12 mb-12 pb-10 border-b" style="border-color: rgba(109, 36, 23, 0.25);">
      <p class="label mb-5" style="color: #7a392c;">
        Essay {pad(e.data.number)} · {monthYear(e.data.date)} · {e.data.minutes} Min. Lesezeit
      </p>
      <h1 class="font-serif text-3xl sm:text-5xl leading-[1.1] tracking-tight lowercase" style="color: #6d2417;">
        {e.data.title}
      </h1>
    </header>

    <div class="prose-essay">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t" style="border-color: rgba(109, 36, 23, 0.25);">
      <p class="label mb-4" style="color: #6d2417;">Wenn dir das gefallen hat</p>
      <p class="leading-relaxed" style="color: #55423f;">
        Dann schreib mir einen Brief, wenn es einen neuen Text gibt, oder lies
        weiter im{" "}
        <a href="/#archiv" class="underline decoration-1 underline-offset-4 hover:opacity-70 transition-opacity" style="color: #6d2417;">
          Archiv
        </a>
        .
      </p>
    </footer>
  </article>
</Base>