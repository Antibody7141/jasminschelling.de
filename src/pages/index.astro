---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { monthYear, pad, WORDMARK } from "../utils";

const essays = (await getCollection("essays")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const lead = essays[0];
---

<Base
  title={`${WORDMARK} — ${"Essays & Notizen"}`}
  description="Essays und Notizen über das Elternsein ohne Weichzeichner. Von Jasmin Schelling."
>
  <!-- Hero: Lead-Essay -->
  <section class="border-b border-linen-200">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 pt-16 pb-20 lg:pt-24 lg:pb-28">
      {lead.data.bild && (
        <img
          src={lead.data.bild}
          alt=""
          class="w-full aspect-video object-cover mb-10"
        />
      )}
      <p class="label mb-6" style="color: #7a392c;">
        {pad(lead.data.number)} · {monthYear(lead.data.date)} · {lead.data.minutes} Min. Lesezeit
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-medium leading-[1.05] tracking-tight lowercase" style="color: #6d2417;">
        {lead.data.title}
      </h1>
      <p class="max-w-xl mt-8 mb-10 text-lg sm:text-xl leading-relaxed font-serif italic" style="color: #622e19;">
        {lead.data.excerpt}
      </p>
      <a class="inline-flex items-center gap-3 px-8 py-4 text-[12px] uppercase tracking-[0.2em] font-semibold rounded-full shadow-md hover:opacity-90 transition-opacity" href={`/essays/${lead.id}/`} style="background-color: #6d2417; color: #ffffff;">
        <span>Diesen Essay lesen</span><span>→</span>
      </a>
    </div>
  </section>

  <!-- Essay-Liste -->
  <section id="essays" class="border-b border-linen-200" style="background-color: #ffffff;">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 lg:py-20">
      <h2 class="label mb-8" style="color: #7a392c;">Alle Essays</h2>
      <div class="divide-y divide-linen-200 border-y border-linen-200">
        {essays.map((e) => (
          <a href={`/essays/${e.id}/`} class="group flex items-baseline justify-between gap-6 py-6">
            <span class="flex items-baseline gap-4 min-w-0">
              <span class="text-[11px] uppercase tracking-[0.22em] font-bold shrink-0" style="color: #7a392c;">{pad(e.data.number)}</span>
              <span class="font-serif text-xl sm:text-2xl lowercase group-hover:opacity-70 transition-opacity" style="color: #6d2417;">{e.data.title}</span>
            </span>
            <span class="text-xs uppercase tracking-wider shrink-0" style="color: #7e442e;">{monthYear(e.data.date)} · {e.data.minutes} Min.</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Über mich -->
  <section id="ueber-mich" class="border-b border-linen-200" style="background-color: #fbf8f4;">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 lg:py-20">
      <h2 class="label mb-8" style="color: #7a392c;">Über mich</h2>
      <p class="text-lg leading-relaxed mb-6" style="color: #55423f;">
        Ich habe mir Elternschaft wie Zuckerwatte vorgestellt: bunt, flauschig, süß. Ist sie nicht. Sie ist ganz schön tough. Und so sehr ich meine zwei Kinder liebe, und ich liebe sie sehr, so sehr vermisse ich auch mein altes Leben. Beides ist wahr. Beides darf sein. Eigentlich sagt man so etwas nicht. Ich mache es trotzdem.
      </p>
      <p class="text-lg leading-relaxed mb-6" style="color: #55423f;">
        Ich war TV-Producerin. Kreativ, bunt, laut, das bin ich. Nur die Welt, in der ich das ausgelebt habe, hat mich irgendwann kaputt gemacht. Und was ich jetzt mache, ist das Gegenteil von allem, was ich bin. Also suche ich. Ich bin immer schon auf der Suche gewesen.
      </p>
      <p class="text-lg leading-relaxed mb-8" style="color: #55423f;">
        Hier schreibe ich Essays über das Elternsein ohne Weichzeichner. Nicht als Ratgeber und nicht für alle, sondern für die, die morgens um sechs allein am Küchentisch sitzen. Kein Kitsch. Kein Flausch. Sondern ehrlich. Direkt. Echt.
      </p>
    </div>
  </section>

  <!-- Kontakt -->
    <section id="kontakt" class="py-16 lg:py-20" style="background-color: #6d2417;">
      <div class="max-w-2xl mx-auto px-6 sm:px-8 text-center">
        <h2 class="font-serif text-3xl sm:text-4xl font-medium mb-4 leading-tight" style="color: #ffdad3;">Schreib mir.</h2>
        <p class="text-base sm:text-lg leading-relaxed mb-8" style="color: #f3ede4;">Kein Newsletter, kein Sammeln von Adressen. Wenn du mir etwas schreiben willst, schreib mir einfach direkt.</p>
        <a href="mailto:jasmin@catmanverlag.de" class="inline-flex items-center gap-3 px-8 py-4 text-[12px] uppercase tracking-[0.2em] font-semibold rounded-full transition hover:opacity-90" style="background-color: #ffdad3; color: #6d2417;">
          <span>jasmin@catmanverlag.de</span><span>→</span>
        </a>
      </div>
    </section>
</Base>